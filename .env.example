DB_USER=your_postgres_user
DB_HOST=localhost
DB_NAME=your_database_name
DB_PASSWORD=your_password
DB_PORT=5432
DB_POOL_MAX=12
DB_CONNECTION_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=30000
APP_TIME_ZONE=America/Regina

# Shared folder used by every workstation for client and item photos.
IMAGE_ROOT=C:/PawnShopData/images

LEADSONLINE_ENV=sandbox
LEADSONLINE_STORE_ID=your_store_id
LEADSONLINE_USERNAME=your_api_username
LEADSONLINE_PASSWORD=your_api_password
